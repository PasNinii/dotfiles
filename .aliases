#############################################
# generics aliases
#############################################
alias rm="rm -i"
alias mv="mv -i"
alias cp="cp -i"

# docker aliases
alias dcs="docker ps -a --format '{{.Names}}'"

# required within docker for comment transparent background
export TERM=screen-256color
export SHELL=/usr/bin/zsh

alias p10kc="p10k configure"

#############################################
# git aliases
#############################################
alias pullall="ls | xargs -I{} git -C {} pull"

alias gd='git diff -M'
alias gd.='git diff -M --color-words="."'
alias gdc='git diff --cached -M'
alias gdc.='git diff --cached -M --color-words="."'

alias ga="git add"
alias gaa="git add ."
alias gap='ga -p'
alias gc="git commit -m"
alias gca="git commit --amend"
alias gcm='git commit -m "merge(master)"'

alias gpl="git pull"
alias gph="git push"

alias gco="git checkout"
alias gcb="git checkout -b"
alias gbd="git branch -d"
alias gbm="git branch -m"

alias gch='git cherry-pick'
alias gf='git fetch'

alias gm='git merge --no-ff'
alias gmf='git merge --ff-only'
alias gmm="git merge master"

alias gsi="git stash --include-untracked"
alias gsp="git stash pop" 

# example to kill PID on port 4200
alias k='printf "%s\n" "kill \$(lsof -Fp -i :4200 | grep -o -P -m1 '\''\d+(?![0-9.])'\'')"'

alias deva="dev && cd angularux"
alias sn="ng serve --port=4200 --host=0.0.0.0 --configuration=development"
alias sng="deva && rm -rf .angular && sn"
alias sngi="deva && rm -rf node_modules && yarn && sn"

alias pme="gh pr list --author=@me"
alias rme="gh pr list --search 'review-requested:@me'"

